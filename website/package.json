{
  "name": "website",
  "type": "module",
  "version": "0.0.1",
  "scripts": {
    "predev": "node scripts/sync-static.mjs && uv run --extra docs python scripts/gen_api.py",
    "dev": "astro dev --force",
    "prebuild": "node scripts/sync-static.mjs && uv run --extra docs python scripts/gen_api.py",
    "build": "astro build --force",
    "preview": "astro preview",
    "test": "vitest run",
    "e2e": "playwright test",
    "check:urls": "node scripts/check-urls.mjs",
    "check:links": "node scripts/check-links.mjs",
    "check:api": "node scripts/check-api.mjs",
    "ci": "uv run --extra docs python scripts/gen_api.py && astro build --force && npm run check:urls && npm run check:links && npm run check:api && vitest run && playwright test"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "^7.3.6",
    "@astrojs/starlight": "^0.42.10",
    "astro": "^7.4.7",
    "sharp": "^0.35.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.65.0",
    "esbuild": "^0.28.2",
    "hast-util-to-html": "^9.0.6",
    "hast-util-to-string": "^3.0.1",
    "mdast-util-to-string": "^4.0.0",
    "parse5": "^8.1.0",
    "rehype-raw": "^7.0.0",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.2.0",
    "vitest": "^5.1.0",
    "yaml": "^2.9.1"
  },
  "private": true,
  "engines": {
    "node": ">=22.12.0 <23"
  }
}
