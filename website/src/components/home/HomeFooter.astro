---
import icon from '../../assets/brand/myogestic-icon.svg';
---

<footer class="pad-x" style="max-width: 1360px; margin: 0 auto; padding: 120px 40px 56px">
  <div style="display: flex; flex-wrap: wrap; align-items: center; gap: 16px 32px; padding-top: 28px;">
    <img src={icon.src} alt="" style="width: 36px; height: 36px; display: block">
    <span style="font-size: 13.5px; color: color-mix(in srgb, var(--mg-home-ink) 70%, transparent)">n-squared lab · Friedrich-Alexander-Universität Erlangen-Nürnberg</span>
    <span style="flex: 1 1 0"></span>
    <span style="display: flex; flex-wrap: wrap; gap: 6px 22px; font: 500 12px/1 var(--mg-font-mono); letter-spacing: 0.06em; text-transform: uppercase">
      <a href="https://github.com/NsquaredLab/MyoGestic" style="color: color-mix(in srgb, var(--mg-home-ink) 75%, transparent); text-decoration: none; padding: 10px 0">GitHub</a>
      <a href="https://pypi.org/project/myogestic/" style="color: color-mix(in srgb, var(--mg-home-ink) 75%, transparent); text-decoration: none; padding: 10px 0">PyPI</a>
      <a href="https://github.com/NsquaredLab/MyoGestic/blob/main/CHANGELOG.md" style="color: color-mix(in srgb, var(--mg-home-ink) 75%, transparent); text-decoration: none; padding: 10px 0">Changelog</a>
      <span style="color: color-mix(in srgb, var(--mg-home-ink) 55%, transparent); padding: 10px 0">GPL-3.0</span>
    </span>
  </div>
</footer>
