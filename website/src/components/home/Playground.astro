---
const base = import.meta.env.BASE_URL;
// Static preview paths match the approved mockup; only the hero animates.
let seed = 7;
const random = () => { seed = (seed * 1664525 + 1013904223) >>> 0; return seed / 4294967296; };
const traces = Array.from({ length: 8 }, (_, channel) => {
    let path = '';
    for (let i = 0; i <= 300; i++) {
        const t = i / 300;
        const envelope = 0.12 + 0.88 * Math.exp(-0.5 * ((t - 0.62) / 0.12) ** 2) * (channel % 3 === 1 ? 0.5 : 1);
        const value = (random() + random() + random() - 1.5) * envelope * 26;
        path += `${i ? 'L' : 'M'}${i * 2} ${(20 + channel * 40 - value).toFixed(1)}`;
    }
    return path;
});
---

<section id="playground" style="margin-top: 100px; background: var(--mg-console-bg); border-top: 1px solid color-mix(in srgb, var(--mg-home-hairline) 45%, transparent); border-bottom: 1px solid color-mix(in srgb, var(--mg-home-hairline) 45%, transparent)">
  <div class="pad-x" style="max-width: 1360px; margin: 0 auto; padding: 110px 40px">
    <div style="display: flex; align-items: center; gap: 16px; font: 500 12px/1 var(--mg-font-mono); letter-spacing: 0.1em; text-transform: uppercase; color: color-mix(in srgb, var(--mg-home-ink) 62%, transparent)"><span>07 · Playground</span><span style="flex: 1 1 auto; border-top: 1px solid color-mix(in srgb, var(--mg-home-hairline) 60%, transparent)"></span></div>
    <div style="display: flex; flex-wrap: wrap; gap: 24px 64px; align-items: flex-end; margin-top: 26px">
