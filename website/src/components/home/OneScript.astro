---
import { Image } from 'astro:assets';
import screenshot from '../../../../docs/images/hello-emg.png';
---

<section id="docs" class="pad-x" style="max-width: 1360px; margin: 0 auto; padding: 120px 40px 40px">
  <div style="display: flex; align-items: center; gap: 16px; font: 500 12px/1 var(--mg-font-mono); letter-spacing: 0.1em; text-transform: uppercase; color: color-mix(in srgb, var(--mg-home-ink) 62%, transparent)"><span>A minimal app</span></div>
  <h2 class="h2" style="margin: 26px 0 0; font-family: var(--mg-font-display); font-weight: 400; font-size: 56px; line-height: 1.04; max-width: 820px">Hello EMG</h2>
  <div style="margin-top: 44px; display: flex; flex-wrap: wrap; gap: 24px; align-items: stretch">
    <div style="flex: 1 1 520px; min-width: 0; background: var(--mg-console-bg); border: 1px solid color-mix(in srgb, var(--mg-home-hairline) 50%, transparent); border-radius: 10px; overflow: hidden">
      <div style="display: flex; justify-content: space-between; align-items: center; height: 40px; padding: 0 16px; border-bottom: 1px solid color-mix(in srgb, var(--mg-home-hairline) 45%, transparent); font: 500 11px/1 var(--mg-font-mono); letter-spacing: 0.08em; text-transform: uppercase; color: color-mix(in srgb, var(--mg-home-ink) 62%, transparent)"><span>hello_emg.py</span><span>Python 3.12+</span></div>
<pre tabindex="0" role="region" aria-label="Hello EMG Python script" style="margin: 0; padding: 20px 22px; font: 400 13.5px/1.7 var(--mg-font-mono); color: var(--mg-console-text); white-space: pre; overflow-x: auto"><code is:raw><span style="color: var(--mg-home-code-keyword)">from</span> myogestic <span style="color: var(--mg-home-code-keyword)">import</span> App, Stream
<span style="color: var(--mg-home-code-keyword)">from</span> myogestic.sources <span style="color: var(--mg-home-code-keyword)">import</span> LSLSource
<span style="color: var(--mg-home-code-keyword)">from</span> myogestic.widgets <span style="color: var(--mg-home-code-keyword)">import</span> RecordingControls, SignalViewer

app = App(<span style="color: var(--mg-home-code-string)">"Hello EMG"</span>)
app.streams(Stream(<span style="color: var(--mg-home-code-string)">"emg"</span>, source=LSLSource(<span style="color: var(--mg-home-code-string)">"EMG"</span>), window_ms=1000))

viewer = SignalViewer(<span style="color: var(--mg-home-code-string)">"emg"</span>)
recording = RecordingControls(
    [<span style="color: var(--mg-home-code-string)">"Rest"</span>, <span style="color: var(--mg-home-code-string)">"Fist"</span>], on_record=app.start_recording, on_stop=app.stop_recording
)


<span style="color: var(--mg-home-code-decorator)">@app.ui</span>
<span style="color: var(--mg-home-code-keyword)">def</span> ui(ctx):
    viewer.ui(ctx)
    recording.ui(ctx)


app.run()</code></pre>
    </div>
    <div class="hello-window" style="flex: 1 1 560px; min-width: 0; background: var(--mg-canvas); border: 1px solid color-mix(in srgb, var(--mg-home-hairline) 55%, transparent); border-radius: 10px; overflow: hidden; display: flex; flex-direction: column">
      <Image src={screenshot} format="webp" quality={80} width={720} alt="Hello EMG app with SignalViewer and RecordingControls in the dark theme" loading="lazy" style="display: block; width: 100%; height: auto; flex: 1; min-height: 0; object-fit: contain" />
    </div>
  </div>
  <p style="margin: 16px 0 0; font: 400 12px/1.6 var(--mg-font-mono); color: color-mix(in srgb, var(--mg-home-ink) 55%, transparent)">To train and predict, add a Pipeline with extract, train and predict functions.</p>
</section>
