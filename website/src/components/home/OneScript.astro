---
import { Image } from 'astro:assets';
import screenshot from '../../../../docs/images/hello-emg.png';

// Each code group links to the part of the window it builds (regions in % of the screenshot).
type Link = 'title' | 'stream' | 'viewer' | 'recording' | 'window';
type Token = [string, ('k' | 's' | 'd')?];
const code: [Link | null, Token[]][] = [
  [null, [['from', 'k'], [' myogestic '], ['import', 'k'], [' App, Stream']]],
  [null, [['from', 'k'], [' myogestic.sources '], ['import', 'k'], [' LSLSource']]],
  [null, [['from', 'k'], [' myogestic.widgets '], ['import', 'k'], [' RecordingControls, SignalViewer']]],
  [null, []],
  ['title', [['app = App('], ['"Hello EMG"', 's'], [')']]],
  ['stream', [['app.streams(']]],
  ['stream', [['    Stream('], ['"emg"', 's'], [', source=LSLSource('], ['"EMG"', 's'], ['), window_ms=1000)']]],
  ['stream', [[')']]],
  [null, []],
  ['viewer', [['viewer = SignalViewer('], ['"emg"', 's'], [')']]],
  ['recording', [['recording = RecordingControls(']]],
  ['recording', [['    ['], ['"Rest"', 's'], [', '], ['"Fist"', 's'], ['],']]],
  ['recording', [['    on_record=app.start_recording,']]],
  ['recording', [['    on_stop=app.stop_recording,']]],
  ['recording', [[')']]],
  [null, []],
  ['window', [['@app.ui', 'd']]],
  ['window', [['def', 'k'], [' ui(ctx):']]],
  ['viewer', [['    viewer.ui(ctx)']]],
  ['recording', [['    recording.ui(ctx)']]],
  [null, []],
  ['window', [['app.run()']]],
];
const blocks: { link: Link | null; lines: Token[][] }[] = [];
for (const [link, tokens] of code) {
  const last = blocks.at(-1);
  if (last && last.link === link) last.lines.push(tokens);
  else blocks.push({ link, lines: [tokens] });
}
const regions: Record<Link, { x: number; y: number; w: number; h: number; label: string; name: string }> = {
  title: { x: 0, y: 0, w: 100, h: 4.4, label: 'App("Hello EMG")', name: 'the title bar' },
  stream: { x: 26.3, y: 15.4, w: 69.8, h: 73.4, label: 'Stream + LSLSource', name: 'the EMG traces' },
  viewer: { x: 24.6, y: 6.6, w: 73.7, h: 91.3, label: 'SignalViewer', name: 'the signal viewer' },
  recording: { x: 1.6, y: 6.6, w: 22, h: 91.3, label: 'RecordingControls', name: 'the recording controls' },
  window: { x: 0, y: 0, w: 100, h: 100, label: 'app.run()', name: 'the whole window' },
};
const colour = { k: 'var(--mg-home-code-keyword)', s: 'var(--mg-home-code-string)', d: 'var(--mg-home-code-decorator)' };
const hits: Link[] = ['title', 'recording', 'viewer', 'stream'];
---

<section id="docs" class="pad-x" style="max-width: 1360px; margin: 0 auto; padding: 120px 40px 40px">
  <div style="display: flex; align-items: center; gap: 16px; font: 500 12px/1 var(--mg-font-mono); letter-spacing: 0.1em; text-transform: uppercase; color: color-mix(in srgb, var(--mg-home-ink) 62%, transparent)"><span>A minimal app</span></div>
  <h2 class="h2" style="margin: 26px 0 0; font-family: var(--mg-font-display); font-weight: 400; font-size: 56px; line-height: 1.04; max-width: 820px">Hello EMG</h2>
  <div data-hello data-regions={JSON.stringify(regions)} style="margin-top: 44px; display: flex; flex-wrap: wrap; gap: 24px; align-items: stretch">
    <div style="flex: 0 1 540px; min-width: 0; background: var(--mg-console-bg); border: 1px solid color-mix(in srgb, var(--mg-home-hairline) 50%, transparent); border-radius: 10px; overflow: hidden">
      <div style="display: flex; justify-content: space-between; align-items: center; height: 40px; padding: 0 16px; border-bottom: 1px solid color-mix(in srgb, var(--mg-home-hairline) 45%, transparent); font: 500 11px/1 var(--mg-font-mono); letter-spacing: 0.08em; text-transform: uppercase; color: color-mix(in srgb, var(--mg-home-ink) 62%, transparent)"><span>hello_emg.py</span><span>Python 3.12+</span></div>
      <div class="hello-code" role="group" aria-label="hello_emg.py">
        {blocks.map((block) => {
          const rows = block.lines.map((tokens) => (
            <span class="hello-row">{tokens.map(([text, kind]) => kind ? <span style={`color: ${colour[kind]}`}>{text}</span> : text)}</span>
          ));
          return block.link
            ? <button type="button" class="hello-line" data-link={block.link}>{rows}</button>
            : <div class="hello-line">{rows}</div>;
        })}
      </div>
    </div>
    <div class="hello-window" style="flex: 1 1 560px; min-width: 0; display: flex; align-items: center; background: var(--mg-canvas); border: 1px solid color-mix(in srgb, var(--mg-home-hairline) 55%, transparent); border-radius: 10px; padding: 10px">
      <div class="hello-shot" style="flex: 1 1 auto">
        <Image src={screenshot} format="webp" quality={80} width={720} alt="Hello EMG app with SignalViewer and RecordingControls in the dark theme" loading="lazy" style="display: block; width: 100%; height: auto" />
        {hits.map((id) => {
          const r = regions[id];
          return <button type="button" class="hello-hit" data-link={id} aria-label={`Show the code for ${r.name}`} style={`left: ${r.x}%; top: ${r.y}%; width: ${r.w}%; height: ${r.h}%`}></button>;
        })}
        <div class="hello-spot" data-spot aria-hidden="true" hidden><span data-spot-label></span></div>
      </div>
    </div>
  </div>
</section>

<style>
  .hello-code { padding: 14px 0; font: 400 12.5px/1.6 var(--mg-font-mono); color: var(--mg-console-text); }
  .hello-line { display: block; box-sizing: border-box; width: 100%; margin: 0; padding: 0 22px; border: 0; background: transparent; color: inherit; font: inherit; text-align: left; transition: opacity 120ms, background-color 120ms; }
  button.hello-line { cursor: pointer; }
  .hello-row { display: block; min-height: 1.6em; white-space: pre; }
  [data-hello][data-active] .hello-line { opacity: 0.42; }
  [data-hello][data-active] .hello-line.is-active { opacity: 1; background: color-mix(in srgb, var(--mg-selected-line) 14%, transparent); box-shadow: inset 2px 0 0 var(--mg-selected-line); }
  .hello-line:focus-visible, .hello-hit:focus-visible { outline: 2px solid var(--mg-selected-line); outline-offset: -2px; }
  .hello-shot { position: relative; border-radius: 6px; overflow: hidden; }
  .hello-hit { position: absolute; padding: 0; border: 0; background: transparent; cursor: pointer; }
  .hello-spot { position: absolute; box-sizing: border-box; border: 2px solid var(--mg-selected-line); border-radius: 8px; pointer-events: none; box-shadow: 0 0 0 9999px color-mix(in srgb, var(--mg-field-bg) 62%, transparent); transition: left 160ms, top 160ms, width 160ms, height 160ms; }
  .hello-spot[hidden] { display: none; }
  .hello-spot span { position: absolute; left: 8px; top: 8px; padding: 4px 8px; border-radius: 4px; background: var(--mg-selected-line); color: var(--mg-field-bg); font: 500 11px/1 var(--mg-font-mono); white-space: nowrap; }
  @media (prefers-reduced-motion: reduce) {
    .hello-line, .hello-spot { transition: none; }
  }
  @media (max-width: 760px) {
    .hello-code { font-size: 12px; }
    .hello-line { padding: 0 14px; }
    /* Long lines wrap with a hanging indent instead of scrolling sideways. */
    .hello-row { white-space: pre-wrap; padding-left: 4ch; text-indent: -4ch; }
  }
</style>
