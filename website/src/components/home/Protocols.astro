---
const base = import.meta.env.BASE_URL;
const examples = `${base}tutorials/examples-index/`;
const protocols = [
  {
    file: 'force_ramps.py',
    title: 'Isometric force ramps',
    text: 'Track a trapezoidal force target at a set percentage of maximum voluntary contraction. EMG, force and target are recorded together.',
    command: 'uv run python examples/start_here/force_ramps.py',
    guide: `${base}how-to/track-a-force-target/`,
  },
  {
    file: 'myocontrol.py',
    title: 'Myocontrol',
    text: 'Record cued Rest and Fist trials, train a classifier or regressor, and drive the Virtual Hand with it.',
    command: 'uv run --extra examples --extra grpc python examples/start_here/myocontrol.py',
    guide: `${examples}#start_heremyocontrolpy-the-whole-loop-as-a-protocol`,
  },
  {
    file: 'pong.py',
    title: 'Pong',
    text: 'Follow a cursor with the paddle to train a signed wrist command from −1 to +1, then play.',
    command: 'uv run --extra examples --extra grpc python examples/start_here/pong.py',
    guide: `${examples}#start_herepongpy-the-first-signed-example`,
  },
];
const otb = `${base}how-to/connect-otb-devices/`;
const pick = `${base}how-to/pick-a-device/`;
const devices = [
  ['Quattrocento', `${otb}#quattrocento-ethernet`],
  ['Muovi', `${otb}#muovi-muovi-wi-fi`],
  ['Muovi+', `${otb}#muovi-muovi-wi-fi`],
  ['Sessantaquattro', `${otb}#sessantaquattro-sessantaquattro-wi-fi`],
  ['Sessantaquattro+', `${otb}#sessantaquattro-sessantaquattro-wi-fi`],
  ['Any LSL stream', `${pick}#devices-that-are-discovered-not-configured`],
  ['Synthetic amplifier', `${pick}#try-it-without-hardware`],
];
const label = 'font: 500 11px/1 var(--mg-font-mono); letter-spacing: 0.08em; text-transform: uppercase; color: color-mix(in srgb, var(--mg-home-ink) 62%, transparent)';
const box = 'background: var(--mg-canvas); border: 1px solid color-mix(in srgb, var(--mg-home-hairline) 55%, transparent); border-radius: 10px';
// Shell highlighting in the Hello EMG block's colours: programs, flags, flag values.
const tint = (token: string, previous?: string) =>
  token === 'uv' || token === 'python' ? 'color: var(--mg-home-code-keyword)'
  : token.startsWith('--') ? 'color: var(--mg-home-code-decorator)'
  : previous?.startsWith('--') ? 'color: var(--mg-home-code-string)'
  : '';
---
<section id="widgets" class="pad-x" style="max-width: 1360px; margin: 0 auto; padding: 120px 40px 0">
  <div style="display: flex; align-items: center; gap: 16px; font: 500 12px/1 var(--mg-font-mono); letter-spacing: 0.1em; text-transform: uppercase; color: color-mix(in srgb, var(--mg-home-ink) 62%, transparent)"><span>Complete protocols</span></div>
  <p style="margin: 18px 0 0; font-size: 15px; color: color-mix(in srgb, var(--mg-home-ink) 78%, transparent)">Run them from a clone of the repository.</p>
  <div style="margin-top: 28px; display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 12px">
    {protocols.map((p) => (
      <article style={`${box}; padding: 22px; display: flex; flex-direction: column; gap: 12px`}>
        <div style={label}>{p.file}</div>
        <h3 style="margin: 0; font-family: var(--mg-font-display); font-weight: 400; font-size: 32px; line-height: 1.1">{p.title}</h3>
        <p style="margin: 0; flex: 1 1 auto; color: color-mix(in srgb, var(--mg-home-ink) 78%, transparent); font-size: 15px">{p.text}</p>
        <div style="display: flex; align-items: stretch; margin-top: 4px; background: var(--mg-field-bg); border: 1px solid color-mix(in srgb, var(--mg-home-hairline) 55%, transparent); border-radius: 8px; overflow: hidden">
          <code style="flex: 1 1 0; min-width: 0; padding: 11px 10px; font: 400 12px/1.6 var(--mg-font-mono); color: color-mix(in srgb, var(--mg-home-ink) 92%, transparent); background: none"><span aria-hidden="true" style="color: color-mix(in srgb, var(--mg-home-ink) 50%, transparent)">$ </span>{p.command.split(' ').map((token, i, tokens) => (
            <>{i > 0 && ' '}{token.split(/(?<=\/)/).map((part, j) => <>{j > 0 && <wbr />}<span style={`white-space: nowrap; ${tint(token, tokens[i - 1])}`}>{part}</span></>)}</>
          ))}</code>
          <button type="button" data-copy-command data-command={p.command} aria-label={`Copy the ${p.file} command`} style="flex: none; min-width: 52px; padding: 0 8px; border: 0; border-left: 1px solid color-mix(in srgb, var(--mg-home-hairline) 55%, transparent); background: var(--mg-home-control); color: var(--mg-text); font: 500 12px/1 var(--mg-font-mono); cursor: pointer">Copy</button>
        </div>
        <span class="sr-only" role="status" data-command-status></span>
        <a href={p.guide} style="align-self: flex-start; padding: 6px 0; font-size: 14.5px; color: var(--mg-link); text-decoration: none">Read the guide →</a>
      </article>
    ))}
  </div>
  <div style={`${box}; margin-top: 12px; display: flex; flex-wrap: wrap; align-items: baseline; gap: 10px 22px; padding: 18px 20px`}>
    <span style={`${label}; margin-right: 4px`}>Set up a device</span>
    {devices.map(([name, href]) => (
      <a href={href} style="font-size: 14.5px; color: var(--mg-link); text-underline-offset: 3px; text-decoration-color: color-mix(in srgb, var(--mg-link) 40%, transparent)">{name}</a>
    ))}
  </div>
</section>
